meta {
  name: 03 - Login y guardar JWT
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{demoEmail}}",
    "password": "{{demoPassword}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) bru.setVar("token", res.getBody().accessToken);
}

tests {
  test("HTTP 200", () => {
    expect(res.getStatus()).to.equal(200);
  });
}
