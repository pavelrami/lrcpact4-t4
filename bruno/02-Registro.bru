}

body:json {
  {
    "nombre": "Alumno Demo",
    "email": "{{demoEmail}}",
    "password": "{{demoPassword}}"
  }
}

tests {
  test("HTTP 201", () => {
    expect(res.getStatus()).to.equal(201);
  });
}
